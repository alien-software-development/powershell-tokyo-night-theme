@echo off
title Applying PowerShell Terminal Theme...
setlocal enabledelayedexpansion

echo.
echo ==========================================================
echo        Applying Custom PowerShell Terminal Theme...
echo ==========================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command "$script = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String('')); Invoke-Expression $script"

echo.
pause